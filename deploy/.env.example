# MyAPI deployment settings. These MYAPI_* names are canonical for new installs.
# Stable images are built and published by the MyAPI GitHub Actions workflow.
# Pin this tag when upgrading; set MYAPI_BUILD_LOCAL=true only for a local build.
MYAPI_IMAGE=ghcr.io/forcemind/myapi:v0.1.1
# Select full for the server edition or lan for the private LAN edition.
MYAPI_EDITION=full
MYAPI_BUILD_LOCAL=false
# Keep the host binding private by default. Set to a private interface or
# 0.0.0.0 only when intentionally sharing the LAN.
MYAPI_BIND_ADDRESS=127.0.0.1
MYAPI_SESSION_COOKIE_SECURE=true
MYAPI_PORT=3000
MYAPI_PUBLIC_URL=https://my-api.example.com
MYAPI_DATA_DIR=./data
MYAPI_LOGS_DIR=./logs
# Existing installations may still use the legacy NEW_API_* names. The MyAPI CLI
# and deploy/install.sh read those names as a compatibility fallback; run
# `myapi migrate --project-dir DIR` to write canonical MYAPI_* keys.
# NEW_API_IMAGE=local/new-api:custom-rc25
# NEW_API_PORT=3000
# NEW_API_PUBLIC_URL=https://new-api.example.com
# NEW_API_DATA_DIR=./data
# NEW_API_LOGS_DIR=./logs
# Optional build-time distribution branding. Runtime site settings still take precedence.
MYAPI_BRAND_NAME=MyAPI
MYAPI_BRAND_LOGO=/myapi-logo-v1.png
SESSION_SECRET=replace-with-a-long-random-secret
FULL_CONTENT_LOG_ENABLED=true
FULL_CONTENT_LOG_MAX_MB=100
FULL_CONTENT_LOG_MAX_FILES=10
# Optional quota history retention. 0 keeps all normalized snapshots; a
# positive value enables a daily, bounded cleanup task (maximum 100 years).
CHANNEL_QUOTA_SNAPSHOT_RETENTION_DAYS=0
# Optional keyless cosign verification for `myapi upgrade`. Keep disabled
# unless cosign is installed and the expected workflow identity is configured.
# MYAPI_VERIFY_IMAGE_SIGNATURE=false
# MYAPI_COSIGN_CERTIFICATE_IDENTITY=https://github.com/ForceMind/MyAPI/.github/workflows/docker-build.yml@refs/tags/v0.1.1
# MYAPI_COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com
