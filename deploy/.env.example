# MyAPI deployment settings. These MYAPI_* names are canonical for new installs.
# `myapi configure` copies this file to deploy/.env, generates SESSION_SECRET and
# writes the two accounting markers for a fresh install; it never overwrites an
# existing deploy/.env. Run `myapi doctor` before `myapi up` to check the result.
#
# Required before the first start (Docker Compose refuses to start without them):
#   SESSION_SECRET                   generated by `myapi configure`; at least 48 characters
#   MYAPI_PUBLIC_URL                 you must set it; the placeholder below is rejected
#   BATCH_UPDATE_ENABLED             fresh installs use false (below)
#   MYAPI_ACCOUNTING_CONFIG_VERSION  fresh installs use 1 (below)
# Everything else is optional and keeps the default shown here.
# Existing deployments retain their explicit image and reviewed accounting settings;
# review the accounting preflight guide before upgrading an existing installation.
#
# Release image. The default tracks this distribution's VERSION. Pin another tag
# only deliberately; `myapi upgrade --version VERSION` rewrites it with a backup.
MYAPI_IMAGE=ghcr.io/forcemind/myapi:v0.2.0-beta.26
# full is the server edition. lite is the restricted personal edition; lan is its
# Legacy alias and behaves identically (case does not matter). Any other value
# stops the application from starting. Lite and lan use the myapi-lan image;
# `myapi lan init` writes lan. An existing lan value is never rewritten to lite.
MYAPI_EDITION=full
MYAPI_BUILD_LOCAL=false
# Fresh, cache-free installations only. Existing installations must preserve
# their reviewed choice; never disable batching to bypass a Redis outage or
# abandon outstanding quota generations. This template does not provide Redis.
BATCH_UPDATE_ENABLED=false
# Fresh configuration contract. Do not add this marker to an old installation
# until its effective writer/cache state and outstanding quota work are reviewed.
MYAPI_ACCOUNTING_CONFIG_VERSION=1
# Keep the host binding private by default. Set to a private interface or
# 0.0.0.0 only when intentionally sharing the LAN.
MYAPI_BIND_ADDRESS=127.0.0.1
# Sharing beyond this machine is opt-in. Keep false unless a private LAN
# interface or 0.0.0.0 binding is intentionally required.
MYAPI_ALLOW_LAN=false
# Full requires true (HTTPS). Lite/lan over local HTTP uses false, which
# `myapi lan init` sets and the CLI and installer apply automatically for lite/lan.
MYAPI_SESSION_COOKIE_SECURE=true
MYAPI_PORT=3000
# Required. Full: the exact public HTTPS origin users open, for example
# https://api.your-domain.com (no path, no placeholder host such as example.com).
# Lite/lan: a localhost or private-network origin, for example http://localhost:3000.
MYAPI_PUBLIC_URL=https://my-api.example.com
MYAPI_DATA_DIR=./data
MYAPI_LOGS_DIR=./logs
# Database names for new installs. For an existing legacy volume, set
# MYAPI_DB_NAME to its current database name before starting; no implicit
# database rename is performed.
MYAPI_DB_NAME=myapi
MYAPI_LOG_DB_NAME=myapi-log
MYAPI_CLICKHOUSE_DB=myapi_logs
# Resource guardrails for Docker Desktop and small servers. Increase only
# after measuring the workload; values use Docker Compose syntax.
MYAPI_CPU_LIMIT=2.0
MYAPI_MEMORY_LIMIT=2g
# Local Docker/Electron builds use at most this many Go package workers.
MYAPI_BUILD_PARALLELISM=2
# Provider account balance sampling is enabled by default in the service; leave
# overrides empty to allow administrators to adjust them from the monitoring UI.
CHANNEL_QUOTA_SYNC_ENABLED=
CHANNEL_QUOTA_SYNC_INTERVAL=
CHANNEL_QUOTA_SYNC_MAX_CHANNELS=
# Stable multi-account quota identity keyring. Generate an independent 32-byte
# base64url secret (without padding) for a new database; keep existing keys on
# upgrade. Share it across instances using that database and back it up safely.
# Never commit real values. Empty disables identity-dependent quota sampling.
# CHANNEL_QUOTA_IDENTITY_KEYS=active:v1:<base64url-secret>
# Threshold status is opt-in and read-only. Cooldown/recovery values are
# notifier-neutral policy metadata; no outbound notification is sent yet.
CHANNEL_QUOTA_ALERT_ENABLED=false
CHANNEL_QUOTA_ALERT_WARNING_PERCENT=20
CHANNEL_QUOTA_ALERT_CRITICAL_PERCENT=10
CHANNEL_QUOTA_ALERT_COOLDOWN_SECONDS=3600
CHANNEL_QUOTA_ALERT_NOTIFY_ON_RECOVERY=false
# Existing installations may still use the legacy NEW_API_* names. The MyAPI CLI
# and deploy/install.sh read those names as a compatibility fallback; run
# `myapi migrate --project-dir DIR` to write canonical MYAPI_* keys.
# NEW_API_IMAGE=local/new-api:custom-rc25
# NEW_API_PORT=3000
# NEW_API_PUBLIC_URL=https://new-api.example.com
# NEW_API_DATA_DIR=./data
# NEW_API_LOGS_DIR=./logs
# Optional build-time distribution branding. Runtime site settings still take precedence.
MYAPI_BRAND_NAME=MyAPI
MYAPI_BRAND_LOGO=/myapi-logo-v1.png
# Required. `myapi configure` writes a random value; if you edit this by hand use at
# least 48 random characters, keep this file at mode 0600, and never reuse a secret
# from another installation. The CLI never prints it.
SESSION_SECRET=replace-with-a-long-random-secret
FULL_CONTENT_LOG_ENABLED=true
FULL_CONTENT_LOG_MAX_MB=100
FULL_CONTENT_LOG_MAX_FILES=10
# Optional quota history retention. 0 keeps all normalized snapshots; a
# positive value enables a daily, bounded cleanup task (maximum 100 years).
CHANNEL_QUOTA_SNAPSHOT_RETENTION_DAYS=0
# Optional keyless cosign verification for `myapi upgrade`. Keep disabled
# unless cosign is installed and the expected workflow identity is configured.
# MYAPI_VERIFY_IMAGE_SIGNATURE=false
# Optional post-pull digest pinning for `myapi upgrade`; this resolves the
# pulled tag once, then persists the immutable repository digest in `.env`.
# MYAPI_PIN_IMAGE_DIGEST=false
# MYAPI_COSIGN_CERTIFICATE_IDENTITY=https://github.com/ForceMind/MyAPI/.github/workflows/docker-build.yml@refs/tags/v<version>
# MYAPI_COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com
