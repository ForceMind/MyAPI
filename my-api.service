# Preview with: bash deploy/install-native.sh render-unit --scope system
# B3a does not install this unit, create its paths, or control any service.
# Existing installations are not adopted by this template.
[Unit]
Description=MyAPI Service
After=network.target

[Service]
Type=simple
User=my-api
Group=my-api
WorkingDirectory=/var/lib/my-api/data
# The required configuration file can override this new-install SQLite default.
Environment="SQLITE_PATH=/var/lib/my-api/data/my-api.db?_busy_timeout=30000"
EnvironmentFile=/etc/my-api/my-api.env
ExecStart=/opt/my-api/current/my-api --log-dir /var/log/my-api
Restart=on-failure
RestartSec=5
# Go allows 120 seconds by default for HTTP shutdown, followed by cache flush.
# An unconfirmed stop must not be treated as permission to change the instance.
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The application cannot write installation state, backups, or runtime files.
ReadWritePaths=/var/lib/my-api/data /var/log/my-api /var/cache/my-api

[Install]
WantedBy=multi-user.target
