+func TestChatCompletionsRequestToResponsesRequestFlattensFileContent(t *testing.T) {
+	tests := []struct {
+		name     string
+		file     map[string]any
+		filename string
+		fileData string
+		fileID   string
+	}{
+		{
+			name: "inline file data",
+			file: map[string]any{
+				"filename":  "notes.txt",
+				"file_data": "data:text/plain;base64,SGVsbG8=",
+			},
+			filename: "notes.txt",
+			fileData: "data:text/plain;base64,SGVsbG8=",
+		},
+		{
+			name:   "uploaded file id",
+			file:   map[string]any{"file_id": "file_123"},
+			fileID: "file_123",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := ChatCompletionsRequestToResponsesRequest(&dto.GeneralOpenAIRequest{
+				Model: "gpt-test",
+				Messages: []dto.Message{{
+					Role: "user",
+					Content: []any{
+						map[string]any{"type": dto.ContentTypeFile, "file": tt.file},
+						map[string]any{"type": dto.ContentTypeText, "text": "read this file"},
+					},
+				}},
+			})
+			require.NoError(t, err)
+
+			filePart := gjson.GetBytes(got.Input, "0.content.0")
+			assert.Equal(t, "input_file", filePart.Get("type").String())
+			assert.Equal(t, tt.filename, filePart.Get("filename").String())
+			assert.Equal(t, tt.fileData, filePart.Get("file_data").String())
+			assert.Equal(t, tt.fileID, filePart.Get("file_id").String())
+			assert.False(t, filePart.Get("file").Exists())
+		})
+	}
+}
